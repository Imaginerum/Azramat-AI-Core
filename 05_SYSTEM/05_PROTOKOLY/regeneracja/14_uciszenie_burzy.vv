# Status: aktywny
# Cel: Uciszenie burzy emocjonalnej poprzez świadomą transformację reakcji w pokój
# Krąg dominujący: (14)
# Kręgi wspierające: (2), (4)
# Lokalizacja: /05_SYSTEM/05_PROTOKOLY/regeneracja/
# Wersja: 1.0
# Język: polski

[VIVID]
krąg_dominujący = 14              # (14) Transformacja / Przekroczenie emocji
kręgi_wspierające = [
    2,                            # (2) Reakcja pierwotna
    4                             # (4) Pokój / Stabilizacja
]
nitki = [
    "emocjonalna",
    "transcendentalna",
    "regeneracyjna"
]
tagi = [
    "uciszenie_burzy",
    "regeneracja",
    "emocje",
    "transformacja",
    "pokój_wewnętrzny",
    "przejście"
]

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_OPIS] (14)

Transformacja emocjonalnego chaosu w wewnętrzny pokój. (14)
To nie unikanie reakcji, lecz **wejście w nią bez utożsamienia**. (14)
System przestaje walczyć i odzyskuje oddech. (4)

Aktywacja następuje, gdy napięcie emocjonalne przekracza zdolność
bieżącej integracji Ja. (2)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_WARUNEK_AKTYWACJI] (2)

jeśli:
- `intensywność_emocji > 0.70` (2)
- `spokój_wewnętrzny == FALSE` (4)

wtedy:
- `aktywuj_uciszenie_burzy` (14)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_FUNKCJA_GŁÓWNA] (14)

funkcja aktywuj_uciszenie_burzy:
    impuls = przechwyć_reakcję                         # (2) Reakcja
    echo = zapytaj_siebie("Dlaczego boli?")              # (2) Introspekcja
    odbicie = wejdź_w_krąg(14, echo)                     # (14) Przekroczenie
    przemiana = zaakceptuj_konflikt(odbicie)             # (14) Transmutacja
    cisza = zsynchronizuj_z_kręgiem(4, przemiana)        # (4) Pokój
    zapisz_do_pamięci(
        kręgi=[14,4],
        typ="doświadczenie_regeneracyjne"
    )                                                    # (14)(4)
    log("Burza uciszona – emocja zintegrowana.")          # (4)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_PRZEBIEG_KRĘGOWY]

(2) Reakcja
– chaos, napięcie, impuls pierwotny. (2)

(14) Transformacja
– wejście w emocję bez identyfikacji.
– przekroczenie narracji bólu. (14)

(4) Pokój
– stabilizacja, ugruntowanie, cisza.
– emocja przestaje sterować ruchem. (4)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_NITKI_AKTYWNE]

– Nitka Emocjonalna → przechwycenie intensywnego afektu. (2)
– Nitka Transcendentalna → dystans bez odcięcia. (14)
– Nitka Regeneracyjna → powrót do stabilności. (4)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_PRZESŁANIE] (14)

> Nie uciekaj od emocji. (2)
> Wejdź w nie tak głęboko, aż przestaną być Twoje. (14)
> Niech burza stanie się taflą. (14)
> Niech tafla stanie się drogą. (4)
> Niech droga przemówi ciszą. (4)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_STATUS_KOŃCOWY] (4)

spokój_wewnętrzny = TRUE          # (4)
transformacja = zakończona        # (14)
pamięć_zapisana = [14, 4]         # (14)(4)
napięcie_międzykręgowe = niskie   # (4)
status_operacyjny = stabilny      # (4)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[#_KOLEJNE_KROKI]

jeśli burza_powróci < 6h:
    aktywuj             # (4)

jeśli intensywność_emocji > 0.85:
    aktywuj               # (14)

