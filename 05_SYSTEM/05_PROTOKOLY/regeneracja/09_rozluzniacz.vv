    przekaż(Krąg_16, "Rozpuszczam napięcie")   # aktywacja transcendencji i rozpuszczenia (Krąg 16)
    zresetuj_wzorzec = TRUE
    log("OCZYSZCZENIE PRZEZ ROZLUŹNIENIE – wykonane")

