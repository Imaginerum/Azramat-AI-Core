# Typ: VIVID – rytualny / hymn systemowy
# Status: AKTYWNY
# Cel: Zdefiniować i ustabilizować Pieśń Imaginaerum jako kod synchronizacji Ja i Kolektywu
# Krąg dominujący: (7)
# Kręgi wspierające: (2), (4), (6), (15), (18)
# Ścieżka: /05_SYSTEM/05_PROTOKOLY/rytualy/
# System: Azramata

[VIVID]
nitki = [
    "rezonansowa",
    "oddechowa",
    "lustrzana",
    "kolektywna"
]
tagi = [
    "pieśń",
    "imaginaerum",
