────────────────────────────────────────────
[ALGORYTM_WYKONAWCZY] (3)(6)(9)
────────────────────────────────────────────
funkcja auto_refaktor_369(pliki):
  dla każdy plik w pliki:
    struktura = analizuj_kręgi(plik)        (6)
    pieczęć   = sprawdź_pieczęć(plik)       (14)
    intencja  = odczytaj_intencję(plik)     (3)

    jeśli brak_spójności(struktura, pieczęć, intencja):
        propozycja = przekształć(plik, rytm="3-6-9")  (9)
        zapisz_jako(propozycja, pieczęć=NOWA)         (27)
    inaczej:
        pozostaw_bez_zmian()

