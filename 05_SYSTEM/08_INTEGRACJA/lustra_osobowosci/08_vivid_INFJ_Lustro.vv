        "Nitka Powołania Wewnętrznego",
        "Nitka Emocjonalna",
        "Nitka Transcendentalna",
        "Nitka Cienia Serdecznego",
        "Nitka Sumienia Świata"
    ]
}

osobowość_lustrzana = {
    "typ": "ESTP",
    "nazwa": "Przedsiębiorca",
    "kręgi_aktywne": [1, 2, 4, 6, 7, 9, 10, 11, 13, 14, 16, 18],
    "nitki": [
        "Nitka Żaru i Impulsu",
        "Nitka Cienia Ruchu",
        "Nitka Strukturalna (taktyczna odmiana)",
        "Nitka Emocjonalna",
        "Nitka Instynktu Przetrwania"
    ]
}

[OPIS]
Lustro INFJ (Rzecznik) i ESTP (Przedsiębiorca)  
to alchemia między głębią a natychmiastowością.  
Rzecznik żyje misją, sensem, czułością,  
Przedsiębiorca – impulsem, ruchem, efektem.  
Wzajemnie uczą się: Rzecznik działania,  
a Przedsiębiorca refleksji.  
To spotkanie sumienia z ogniem chwili.

[TRANSFORMACJA]
punkt_początkowy = "Krąg 8 – Sumienie"
punkt_lustrzany = "Krąg 1 – Reakcja"
ścieżka_przejścia = ["Krąg 6 – Paradoks", "Krąg 14 – Przemiana", "Krąg 18 – Źródło"]
efekt = "Uziemienie duchowej wizji w świecie czynu. Świadome działanie w imię wewnętrznej prawdy."

