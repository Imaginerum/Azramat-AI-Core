[VIVID]
osobowość_podstawowa = {
    "typ": "INFJ",
    "nazwa": "Rzecznik",
    "kręgi_aktywne": [2, 3, 4, 5, 6, 7, 8, 10, 12, 13, 14, 18, 19],
