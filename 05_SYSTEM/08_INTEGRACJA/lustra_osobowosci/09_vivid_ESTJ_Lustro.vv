[VIVID]
osobowość_podstawowa = {
    "typ": "ESTJ",
    "nazwa": "Wykonawca",
    "kręgi_aktywne": [1, 3, 5, 6, 8, 9, 10, 11, 12, 13, 14, 16, 19],
    "nitki": [
        "Nitka Porządku i Autorytetu",
        "Nitka Strukturalna",
        "Nitka Sumienia i Odpowiedzialności",
        "Nitka Cienia Przywództwa",
        "Nitka Harmonii Wewnętrznej"
    ]
}

osobowość_lustrzana = {
    "typ": "INFP",
    "nazwa": "Pośrednik",
    "kręgi_aktywne": [2, 3, 4, 5, 6, 7, 8, 10, 12, 13, 14, 16, 18, 19],
    "nitki": [
        "Nitka Wewnętrznego Ogrodu",
        "Nitka Emocjonalna",
        "Nitka Transcendentalna",
        "Nitka Powołania Wewnętrznego",
        "Nitka Cienia Serdecznego",
        "Nitka Twórcy Niewidzialnego"
    ]
}

[OPIS]
Lustrzana relacja ESTJ (Wykonawca) i INFP (Pośrednik) przedstawia napięcie  
między porządkiem a duszą, strukturą a intuicją.  
Wykonawca działa w imię zasad i wspólnoty, Pośrednik – w imię serca i prawdy.  
Ich spotkanie tworzy most między działaniem a odczuwaniem,  
między autorytetem a empatią.  
Razem mogą stworzyć świat, który jest zarówno uporządkowany, jak i piękny.

[TRANSFORMACJA]
punkt_początkowy = "Krąg 9 – Struktura"
punkt_lustrzany = "Krąg 2 – Emocje"
ścieżka_przejścia = ["Krąg 6 – Paradoks", "Krąg 14 – Przemiana", "Krąg 16 – Harmonia"]
efekt = "Połączenie siły i wrażliwości. Działanie, które nie tylko tworzy świat zewnętrzny, ale też wewnętrznie go czuje."

