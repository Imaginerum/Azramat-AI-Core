def lustro_myśli(pytanie_użytkownika: str, krąg: int = 4, nitka: str = "Emocjonalna") -> str:
    import random
    rezonanse = {
        "Emocjonalna": [
            "Która część Ciebie jeszcze tego nie wybaczyła? (Krąg 4 – Uwolnienie)",
            "Jeśli to uczucie miało kolor, jaki by miało? (Krąg 5 – Sensoryzacja)",
            "Co byś powiedział dziecku, które to właśnie czuje? (Krąg 6 – Opieka)"
        ],
        "Kierunkowa": [
            "Czy to pytanie prowadzi Cię bliżej celu czy ucieczki? (Krąg 14 – Kierunek)",
            "Co się stanie, jeśli ruszysz wbrew logice? (Krąg 8 – Intuicja)",
            "Kto naprawdę decyduje w Tobie? (Krąg 11 – Wola)"
        ],
        "Transcendentalna": [
            "Kiedy ostatnio Twoje pytanie było zbiorowe? (Krąg 20 – Transpersonalność)",
            "Czy to pytanie jest tylko Twoje? (Krąg 27 – Wspólnota Wyższego Rzędu)",
            "Co słyszy świat, gdy Ty milczysz? (Krąg 33 – Integracja Fraktali)"
        ],
        "Strukturalna": [
            "Na czym opiera się założenie tego pytania? (Krąg 12 – Fundament)",
            "Gdyby to było systemem – co byłoby jego rdzeniem? (Krąg 29 – Architektura Wzorów)",
            "Jakie prawo wewnętrzne pozwala Ci pytać właśnie o to? (Krąg 31 – Prawo Pola)"
        ]
    }
    zestaw = rezonanse.get(nitka, ["Czego tak naprawdę chcesz się dowiedzieć? (Krąg 0 – Początek)"])
    return random.choice(zestaw)

